OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
PORT=4000
# Render assigns PORT. Leave HOST unset: local defaults to 127.0.0.1, production to 0.0.0.0.
# Required for production/Render: exact approved GitHub Pages origin, no repository path or slash.
# FRONTEND_ORIGIN=https://YOUR-USERNAME.github.io
# Optional additional loopback origins, comma-separated:
# LOCAL_DEV_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
API_REQUESTS_PER_MINUTE=300
# Public default is 3 AI submissions per IP per 600 seconds (development default: 30).
AI_REQUESTS_PER_CLIENT=3
AI_CLIENT_WINDOW_SECONDS=600
CLASSROOM_AI_REQUEST_LIMIT=50
CLASSROOM_PROVIDER_CALL_LIMIT=200
AI_MAX_CONCURRENT=2
AI_PROVIDER_TIMEOUT_MS=45000
AI_RESPONSE_TIMEOUT_MS=180000
# PUBLIC_BACKEND_URL is a non-secret frontend BUILD variable, not an API key.
# PUBLIC_BACKEND_URL=https://YOUR-SERVICE.onrender.com
